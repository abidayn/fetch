# Copy this file to .env and fill in the values. .env is already gitignored.
# NEVER commit .env.

GEMINI_API_KEY=
DATABASE_URL=

# Optional: Groq, the last-resort fallback for classification and answers.
# Without it the fallback chains stay Gemini-only.
GROQ_API_KEY=

# Optional: override the fallback chains (ordered, comma-separated
# "provider:model"; the first entry is the primary). Defaults live in
# classifier.py / answerer.py.
#   CLASSIFY_MODELS=gemini:gemini-3.6-flash,gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b
#   ANSWER_MODELS=gemini:gemini-3.5-flash,gemini:gemini-3.1-flash-lite,groq:openai/gpt-oss-20b

# JWT signing key. At least 32 bytes (RFC 7518 for HS256).
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
