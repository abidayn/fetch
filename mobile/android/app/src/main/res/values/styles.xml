<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LaunchTheme extends Theme.SplashScreen (from androidx
         core-splashscreen), not Theme.Light.NoTitleBar directly. This fixes
         the splash screen freezing permanently when the app is cold-started
         from the share sheet (ACTION_SEND) -- see "Gotchas" in CLAUDE.md.
         Diagnosis: Flutter's built-in splash auto-dismiss (implicit
         first-frame detection) doesn't reliably fire when the Activity is
         created via Android's chooser trampoline instead of a launcher tap.
         Theme.SplashScreen + installSplashScreen() in MainActivity.kt give
         explicit control tied to the Activity's first draw at the Android
         level, rather than to Flutter's detection that doesn't always fire. -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
